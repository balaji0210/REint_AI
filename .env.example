# ==============================================================================
# UK Wind Power Forecasting & Accuracy Dashboard - Environment Variables
# ==============================================================================

# Elexon BMRS API Key
# Optional for public data streams (/datasets/FUELHH/stream, /datasets/WINDFOR/stream)
# Required if connecting to authenticated or enterprise rate-tier endpoints
ELEXON_API_KEY=

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Cache Configuration
# Cache directory for storing raw BMRS stream payloads
CACHE_DIR=data/cache
# Time-To-Live for cache validity before re-querying Elexon API (in hours)
CACHE_TTL_HOURS=24

# CORS Allowed Origins (Comma-separated list of allowed web clients)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend Configuration (Used by Vite bundler - variables must start with VITE_)
# Backend API Base URL for client requests (leave blank or set to local/cloud backend)
VITE_API_URL=http://localhost:8000
